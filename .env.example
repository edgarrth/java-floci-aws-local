# Se admite una región AWS publicada. Se usa us-east-1 para todos los recursos del laboratorio.
AWS_REGION=us-east-1
# Se admite una contraseña de 8 a 128 caracteres. Se usa sólo para crear esquemas y ejecutar Flyway.
# Las aplicaciones obtienen tokens IAM; no se les entrega esta contraseña.
DB_ADMIN_PASSWORD='LocalBootstrapOnly-25!'
# false: k3s real para pods e IRSA local. true: sólo metadatos EKS para pruebas del protocolo SDK.
# El despliegue Kubernetes necesita false.
EKS_MOCK=true
# compose: aplicaciones Docker; host: JVM en Fedora; eks: pods Kubernetes.
# Los archivos compose.host.yml y compose.eks.yml seleccionan el destino automáticamente.
BOOTSTRAP_TARGET=compose
# true: publicación outbox, consumo SQS/MSK, comprobantes y métricas. false: sólo APIs sin workers.
JOBS_ENABLED=true
# Se admite un directorio terminado en /. .runtime/: host; /app/runtime/: Compose; /runtime/: EKS.
# Se sobrescribe en Compose y EKS para localizar los endpoints y la CA descubiertos.
AXIZ_RUNTIME_DIRECTORY=.runtime/
