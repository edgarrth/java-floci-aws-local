# Se selecciona una región AWS publicada; el caso precargado usa us-east-1.
AWS_REGION=us-east-1
# Se usa exclusivamente durante el bootstrap local. Se admite una cadena de 8 a 128 caracteres.
# Las conexiones de los microservicios se autentican mediante IAM, sin esta contraseña.
DB_ADMIN_PASSWORD='LocalBootstrapOnly-25!'
# false: Kubernetes real mediante k3s. true: únicamente metadatos EKS y emisión OIDC para pruebas de SDK.
# El despliegue de pods requiere false.
EKS_MOCK=false
# compose: aplicaciones en Compose. host: aplicaciones en Fedora. eks: aplicaciones en Kubernetes.
BOOTSTRAP_TARGET=compose
# true: outbox, SQS, comprobantes, conciliación y métricas programadas. false: ejecución manual sin workers.
JOBS_ENABLED=true
# Se admite un entero positivo en milisegundos. Se aplica a cada intento HTTP; no al conjunto de reintentos.
RESILIENCE_TIMEOUT_MS=900
# Se admite un entero desde 1. Se cuenta el intento inicial; 3 equivale a dos reintentos como máximo.
RESILIENCE_MAX_ATTEMPTS=3
# Se admite un entero positivo. Se limita la concurrencia activa con un bulkhead de semáforo.
RESILIENCE_MAX_CONCURRENT=8
# Se admite un entero positivo. Se cuentan solicitudes de creación por segundo y por instancia.
RESILIENCE_INGRESS_PER_SECOND=30
# Se admite un entero positivo. Se cuentan intentos salientes por segundo y por instancia.
RESILIENCE_OUTBOUND_PER_SECOND=20
# Se admite un entero positivo de segundos. Se define la espera antes de HALF_OPEN.
RESILIENCE_OPEN_SECONDS=10

# Se admite una ruta de directorio terminada en /. Se leen allí los endpoints descubiertos por bootstrap.
# .runtime/: host. /app/runtime/: Compose. /runtime/: EKS. Se establece automáticamente por modalidad.
AXIZ_RUNTIME_DIRECTORY=.runtime/
