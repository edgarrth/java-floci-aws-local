FROM eclipse-temurin:25.0.4.1_1-jdk-noble
WORKDIR /workspace
COPY mvnw pom.xml ./
COPY platform/pom.xml platform/pom.xml
COPY payment-service/pom.xml payment-service/pom.xml
COPY settlement-service/pom.xml settlement-service/pom.xml
RUN chmod +x mvnw && ./mvnw -B -ntp org.apache.maven.plugins:maven-dependency-plugin:3.11.0:go-offline -DexcludeReactor=true
